task.spawn(function()
	local lastLocalDoors = ""

	-- Loop rápido (0.1s): estado de portas/vidros dos outros players (todas JUNTAS)
	task.spawn(function()
		while true do
			task.wait(next(_DE.act) and 0.1 or 0.5)
			if onlineEnabled then
				pcall(function()
					local evs = _DE:get()
					for _, player in ipairs(PLS:GetPlayers()) do
						if player ~= LocalPlayer then
							local ev = evs[tostring(player.UserId)]
							if type(ev) == "table" and ev.seq and ev.seq ~= (_DE.last[player.UserId] or 0) then
								_DE.last[player.UserId] = ev.seq
								_DE.state[player.UserId] = tostring(ev.doors or "")
								local car = findCarFor(player)
								if car then SLX.applyState(car, _DE.state[player.UserId]) end
							end
						end
					end
				end)
			end
		end
	end)

	-- Loop principal (1s): publica o código + carrega carros dos outros (protegido com pcall)
	while true do
		task.wait(1)
		if onlineEnabled then
			local okc, errc = pcall(function()
				local currentCode = ""
				local prevTarget = targetPlayer
				targetPlayer = LocalPlayer
				local success, result = pcall(function()
					local code = serCfg()
					return code
				end)
				targetPlayer = prevTarget
				if success and type(result) == "string" and result ~= "" then currentCode = result end
				if currentCode ~= lastLocalCode then
					if _K.publishLiveConfig(currentCode) then
						lastLocalCode = currentCode
						local myc = findCarFor(LocalPlayer)
						if myc then SLX.publish(myc) end
					end
				end

				local lives = fetchLiveConfigs()
				local now = os.time()
				for _, player in ipairs(PLS:GetPlayers()) do
					if player ~= LocalPlayer then
						local live = lives[tostring(player.UserId)]
						if live and type(live) == "table" and live.timestamp and (now - (live.timestamp or 0)) <= _K.ONLINE_TIMEOUT then
							pcall(function()
								local incomingCode = (type(live.code) == "string") and live.code or ""
								if incomingCode ~= (lastAppliedCodes[player.UserId] or "___none___") then
									if incomingCode == "" then
										local car = findCarFor(player)
										if car then clearAll(car) end
										lastAppliedCodes[player.UserId] = ""
										_DE.act[player.UserId] = nil
									else
										local ok = _K.applyConfigToPlayer(player, incomingCode)
										if ok then
											lastAppliedCodes[player.UserId] = incomingCode
											local c2 = findCarFor(player)
											if c2 then SLX.applyState(c2, _DE.state[player.UserId], true) end
											_DE.act[player.UserId] = (c2 and SLX.I[c2] and #SLX.I[c2] > 0) or nil
										end
									end
								end
							end)
						end
					end
				end
			end)
			if not okc then warn("[CarCustomizer] online:", errc) end
		end
	end
end)

