function SLX.remove(car,s)
    s.target=0;s.cur=0;pcall(SLX.recompute,car)
    local list=SLX.I[car] or {}
    for i,x in ipairs(list) do if x==s then table.remove(list,i);break end end
    for _,x in ipairs(list) do if x.parent==s then x.parent=s.parent end end
    if s.part and s.part.Parent then pcall(function() s.part:Destroy() end) end
    s.members={};pcall(SLX.recompute,car)
