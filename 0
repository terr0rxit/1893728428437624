local function loadCfg(code)
	code=code:match("^%s*(.-)%s*$");if code=="" then return false,"Código vazio!" end
	local cn=nil
	if _K.isObf(code) then
		local ok,dec=pcall(_K.deobfuscate,code)
		if ok and dec and (dec:find(";") or dec:find("CREATOR:")) then
			code=dec
			local cr,rest=code:match("^CREATOR:([^|]+)|(.+)$")
			if cr then cn=cr;code=rest end
		else return false,"Código inválido!" end
	end
	local function n(v,d) return tonumber(v) or d end
	local function setFolder(e,name) if e then e.folder=(name and name~="" and name) or "Geral" end end
	local pfx=cn and (cn.." ✦ ") or ""
	local count=0
	local doorQueue={}
	local sliderQueue={}
	local intQueue={};local loaded={};local mIdx=0
	for es in code:gmatch("[^|]+") do
		local f={};for v in (es..";"):gmatch("([^;]*);") do table.insert(f,v) end
		local p=f[1];local ok,e
		if p=="M" and #f>=18 then
			mIdx=mIdx+1;if mIdx%8==0 then task.wait() end
			ok,e=addMesh(f[3],f[4],pfx..(f[2]~="" and f[2] or "Mesh"))
			if ok then applyAll(e,n(f[5],0),n(f[6],0),n(f[7],0),n(f[8],0),n(f[9],0),n(f[10],0),n(f[11],1),n(f[12],1),n(f[13],1),n(f[14],255),n(f[15],255),n(f[16],255),n(f[17],0),n(f[18],0));setFolder(e,#f>=19 and f[19] or "Geral");count=count+1;loaded[mIdx]=e end
		elseif p=="FK" and #f>=19 then
			ok,e=_K.addForkByWheel(f[4],f[5],pfx..(f[3]~="" and f[3] or "Fork"),f[2])
			if ok then applyMoto(e,n(f[6],0),n(f[7],0),n(f[8],0),n(f[9],0),n(f[10],0),n(f[11],0),n(f[12],1),n(f[13],1),n(f[14],1),n(f[15],255),n(f[16],255),n(f[17],255),n(f[18],0),n(f[19],0));setFolder(e,#f>=20 and f[20] or "Geral");count=count+1 end
		elseif p=="AX" and #f>=19 then
			ok,e=_K.addAxelByWheel(f[4],f[5],pfx..(f[3]~="" and f[3] or "Axel"),f[2])
			if ok then applyMoto(e,n(f[6],0),n(f[7],0),n(f[8],0),n(f[9],0),n(f[10],0),n(f[11],0),n(f[12],1),n(f[13],1),n(f[14],1),n(f[15],255),n(f[16],255),n(f[17],255),n(f[18],0),n(f[19],0));setFolder(e,#f>=20 and f[20] or "Geral");count=count+1 end
		elseif p=="DH" and #f>=10 then
			-- DH;folder;px;py;pz;rx;ry;rz;angle;axis;visible
			table.insert(doorQueue,f)
		elseif p=="SL" and #f>=4 then
			table.insert(sliderQueue,f)
		elseif p=="IN" and #f>=13 then
			table.insert(intQueue,f)
		elseif p~="M" and p~="FK" and p~="AX" and p~="DH" and p~="SL" and p~="IN" and #f>=16 then
			mIdx=mIdx+1;if mIdx%8==0 then task.wait() end
			ok,e=addMesh(f[2],f[3],pfx..(f[1]~="" and f[1] or "Mesh"))
			if ok then applyAll(e,n(f[4],0),n(f[5],0),n(f[6],0),n(f[7],0),n(f[8],0),n(f[9],0),n(f[10],1),n(f[11],1),n(f[12],1),n(f[13],255),n(f[14],255),n(f[15],255),n(f[16],0),n(f[17],0));setFolder(e,#f>=18 and f[18] or "Geral");count=count+1;loaded[mIdx]=e end
		end
	end
	-- Interações (formato novo IN) + conversão dos formatos antigos (DH/SL por pasta)
	local car=findCarFor(targetPlayer)
	local doorsLoaded=0
	if car then
		local byName={}
		for _,f in ipairs(intQueue) do
			local members={}
			for idx in tostring(f[14] or ""):gmatch("%d+") do
				local e=loaded[tonumber(idx)];if e then table.insert(members,e) end
			end
			local kind=(f[3]=="glass") and "glass" or "door"
			local ok2,sec=SLX.add(car,f[2],kind,members,nil,{
				pos={n(f[4],0),n(f[5],0),n(f[6],0)},rot={n(f[7],0),n(f[8],0),n(f[9],0)},
				axis=(f[10]~="" and f[10]) or "Y",value=n(f[11],kind=="glass" and 1 or 70),visible=n(f[12],1)~=0,group=(f[15] and f[15]~="") and f[15] or nil,auto=(f[16]=="1")})
			if ok2 then byName[f[2]]=sec;sec.pn=f[13];doorsLoaded=doorsLoaded+1 end
		end
		for _,sec in pairs(byName) do
			if sec.pn and sec.pn~="" and byName[sec.pn] and byName[sec.pn]~=sec then SLX.setParent(sec,byName[sec.pn]) end
			sec.pn=nil
		end
		local function inFolder(fp)
			local r={}
			for _,e in pairs(loaded) do
				local fo=e.folder or "Geral"
				if fo==fp or fo:sub(1,#fp+3)==fp.." > " then table.insert(r,e) end
			end
			return r
		end
		for _,f in ipairs(doorQueue) do
			local fp=f[2]~="" and f[2] or "Geral"
			local ok2=SLX.add(car,fp,"door",inFolder(fp),nil,{pos={n(f[3],0),n(f[4],0),n(f[5],0)},rot={n(f[6],0),n(f[7],0),n(f[8],0)},value=n(f[9],70),axis=(f[10]~="" and f[10]) or "Y",visible=n(f[11],1)~=0,auto=false})
			if ok2 then doorsLoaded=doorsLoaded+1 end
		end
		for _,f in ipairs(sliderQueue) do
			local fp=f[2]~="" and f[2] or "Geral"
			local ok2=SLX.add(car,fp,"glass",inFolder(fp),nil,{axis=(f[3]~="" and f[3]) or "Y",value=n(f[4],1),auto=false})
			if ok2 then doorsLoaded=doorsLoaded+1 end
		end
	end
	if count==0 and doorsLoaded==0 then return false,"Nenhum item válido!" end
	local msg=count.." mesh(es) carregado(s)!"
	if doorsLoaded>0 then msg=msg.." + "..doorsLoaded.." interação(ões)" end
	return true,msg
end

-- ══ RESET PARA PRESET (Body invisível + CustomMesh deletados) ═
-- 1) Deleta (Destroy) SOMENTE as Parts chamadas "CustomMesh" do Body
-- 2) Esconde todo o resto do Body (exceto peças protegidas)
-- 3) Libera dobradiças / Fork / Axel criados pelo script (só esconde)
local function resetCarForPreset(car)
	if not car then return end
	local body = car:FindFirstChild("Body")

	-- 1. Deleta somente CustomMesh (rastreados + qualquer sobra no Body)
	for _,e in ipairs(meshesPerCar[car] or {}) do
		if e.part and e.part.Name == "CustomMesh" and e.part.Parent then
			pcall(function() e.part:Destroy() end)
		end
	end
	if body then
		for _,child in ipairs(body:GetChildren()) do
			if child.Name == "CustomMesh" and child:IsA("BasePart") then
				pcall(function() child:Destroy() end)
			end
		end
	end
	meshesPerCar[car] = {}

	-- 2. Remove as interações (portas/vidros) do preset anterior
	SLX.clear(car)

	-- 3. Fork / Axel criados pelo script (só esconde, como antes)
	clearAll(car)

	-- 4. Esconde tudo que sobrou dentro do Body (originais do carro)
	if body then
		for _,child in ipairs(body:GetChildren()) do
			if child.Name ~= "CustomMesh" and not PROTECTED_BODY[child.Name] then
				makeInvisible(child)
			end
		end
	end
end

function _K.applyConfigToPlayer(player, code)
	if not player or not code or code == "" then return false, "dados invalidos" end
	local oldTarget = targetPlayer
	targetPlayer = player
	local car = findCarFor(player)
	if car then
		resetCarForPreset(car)
	end
	local ok, msg = loadCfg(code)
	targetPlayer = oldTarget
	return ok, msg
end

