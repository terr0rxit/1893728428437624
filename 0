local function httpRequest(opts)
	local req = (syn and syn.request) or (http and http.request) or http_request or request
	if not req then
		return { StatusCode = 0, Body = "", Error = "sem request (ative HttpRequest no executor)" }
	end
	local ok, r = pcall(req, opts)
	if not ok then
		return { StatusCode = 0, Body = "", Error = tostring(r) }
	end
	if type(r) ~= "table" then
		return { StatusCode = 0, Body = "", Error = "resposta invalida" }
	end
	local code = r.StatusCode or r.Status or r.status_code or r.status or 0
	local body = r.Body or r.body or ""
	return {
		StatusCode = tonumber(code) or 0,
		Body = tostring(body),
		Success = r.Success == true or tonumber(code) == 200 or tonumber(code) == 201
	}
end

local lastPublishError = ""

-- Firebase devolve objeto { id1 = preset, id2 = preset } ou null
-- Retorna lista ou (nil, erro). base = URL do banco (público / ADM)
function _K.fetchCommunityPresets(base)
	base = base or _K.DB.publico
	local ok, res = pcall(function()
		local r = httpRequest({ Url = base .. "/presets.json", Method = "GET", Headers = { ["Content-Type"] = "application/json" } })
		if not r or r.StatusCode ~= 200 then error("HTTP " .. tostring(r and r.StatusCode) .. " " .. tostring(r and r.Error or "")) end
		local body = r.Body or ""
		if body == "" or body == "null" then return {} end
		local data = HttpService:JSONDecode(body)
		if type(data) ~= "table" then return {} end
		local list = {}
		if #data > 0 then
			for _,p in ipairs(data) do if type(p) == "table" then table.insert(list, p) end end
			return list
		end
		for id, p in pairs(data) do
			if type(p) == "table" and (p.name or p.code) then
				p._fbId = tostring(id)
				table.insert(list, p)
			end
		end
		return list
	end)
	if ok and type(res) == "table" then return res end
	return nil, tostring(res)
end

function _K.sortByName(l)
	table.sort(l, function(a, b) return tostring(a.name):lower() < tostring(b.name):lower() end)
	return l
end

-- POST cria um nó novo em <base>/presets
function _K.publishCommunityPreset(preset, base)
	lastPublishError = ""
	base = base or _K.DB.publico
	local ok, res = pcall(function()
		local r = httpRequest({
			Url = base .. "/presets.json",
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(preset)
		})
		if not r then lastPublishError = "sem resposta HTTP" return false end
		if r.Error and r.StatusCode == 0 then lastPublishError = r.Error return false end
		if r.StatusCode == 200 or r.StatusCode == 201 then return true end
		lastPublishError = "HTTP " .. tostring(r.StatusCode) .. " " .. (r.Body or ""):sub(1, 120)
		return false
	end)
	if not ok then lastPublishError = tostring(res) return false end
	return res == true
end

