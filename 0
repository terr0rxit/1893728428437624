-- Remove itens que não existem mais e seções vazias (depois de apagar mesh/carro)
function SLX.prune(car)
    local list=SLX.I[car];if not list or #list==0 then return false end
    local live={};for _,e in ipairs(meshesPerCar[car] or {}) do live[e]=true end
    local changed=false
    for i=#list,1,-1 do
        local sec=list[i]
        for e in pairs(sec.members) do
            if not (live[e] and SLX.alive(e)) then sec.members[e]=nil;changed=true end
        end
        if next(sec.members)==nil then
            if sec.part and sec.part.Parent then pcall(function() sec.part:Destroy() end) end
            table.remove(list,i);changed=true
        end
    end
    if changed then
        for _,sec in ipairs(list) do if sec.parent and not table.find(list,sec.parent) then sec.parent=nil end end
        pcall(SLX.recompute,car);SLX.publish(car)
    end
    return changed
end

-- Editar um item que pertence a uma seção: recalcula na hora
SLX.after=function(e)
    local car=e.car;local l=car and SLX.I[car];if not l then return end
    for _,s in ipairs(l) do if s.members[e] then s._k=nil;pcall(SLX.recompute,car) return end end
end

-- Driver único (Heartbeat): todas as seções animam JUNTAS e sem travar com spam
function SLX.step(dt)
    SLX.acc=(SLX.acc or 0)+dt
    local doPrune=SLX.acc>=0.5;if doPrune then SLX.acc=0 end
    for car,list in pairs(SLX.I) do
        if not car.Parent then SLX.I[car]=nil
        else
            if doPrune then SLX.prune(car) end
            local moved=false
            for _,s in ipairs(list) do
                local c,t=s.cur or 0,s.target or 0
                if c~=t then
                    local d=dt/(s.dur or 0.45)
                    if t>c then c=math.min(t,c+d) else c=math.max(t,c-d) end
                    s.cur=c;moved=true
                end
            end
            if moved then pcall(SLX.recompute,car,true) end
        end
    end
end
