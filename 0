function makeInvisible(obj)
	-- Deixa invisível o objeto e TUDO dentro (Model, Folder, BasePart, Decal, Texture...)
	if not obj then return end
	local function hideOne(o)
		if o:IsA("BasePart") then
			o.Transparency = 1
			o.CanCollide = false
		elseif o:IsA("Decal") or o:IsA("Texture") then
			o.Transparency = 1
		elseif o:IsA("ParticleEmitter") or o:IsA("Beam") or o:IsA("Trail") then
			o.Enabled = false
		end
	end
	hideOne(obj)
	for _,desc in ipairs(obj:GetDescendants()) do
		hideOne(desc)
	end
end

-- ══ CARREGAMENTO EM LOTES: só cria mais linhas quando a lista rola até perto do fim ══
_K.lazy={}
function _K.lazyRun(sc,jobs,batch,restore)
    local old=_K.lazy[sc]
    if old then old.dead=true;for _,c in ipairs(old.conns) do c:Disconnect() end end
    local st={dead=false,conns={},i=1,busy=false}
    _K.lazy[sc]=st
    batch=batch or 24
    local total=#jobs
    local function more()
        local last=math.min(total,st.i+batch-1)
        for k=st.i,last do pcall(jobs[k]) end
        st.i=last+1
    end
    local function check()
        if st.dead or st.busy then return end
        st.busy=true
        local guard=0
        local scl=(menuUIScale and menuUIScale.Scale) or 1
        while not st.dead and guard<80 do
            local win=sc.AbsoluteWindowSize.Y
            if win<=0 then break end
            local abs=sc.AbsoluteCanvasSize.Y
            local pos=sc.CanvasPosition.Y*scl
            local nearEnd=(pos+win+160>=abs)
            local needRestore=restore and (abs<restore.Y*scl+win)
            if st.i>total or not (nearEnd or needRestore) then break end
            more();guard=guard+1
            task.wait()
        end
        if not st.dead and restore and (st.i>total or sc.AbsoluteCanvasSize.Y>=restore.Y*scl+sc.AbsoluteWindowSize.Y) then
            sc.CanvasPosition=restore;restore=nil
        end
        st.busy=false
    end
    more()
    table.insert(st.conns,sc:GetPropertyChangedSignal("CanvasPosition"):Connect(check))
    table.insert(st.conns,sc:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(check))
    task.defer(check)
end
-- CustomMesh (criado pelo script) é APAGADO; peça original só fica invisível
function _K.dropPart(p)
    if not p then return end
    if p.Name=="CustomMesh" then pcall(function() p:Destroy() end) else makeInvisible(p) end
end

local function clearAll(car, hideOriginals)
	-- hideOriginals = true  → também esconde peças originais do Body/Fork/Axel
	-- hideOriginals = false → só esconde meshes que O SCRIPT criou
	if not car then return end
	hideOriginals = hideOriginals == true

	-- 1. Meshes do Body criados pelo script
	if meshesPerCar[car] then
		for _,e in ipairs(meshesPerCar[car]) do
			if e.part and e.part.Parent then _K.dropPart(e.part) end
		end
		meshesPerCar[car] = {}
	end
	local body = car:FindFirstChild("Body")
	if body then
		for _,child in ipairs(body:GetChildren()) do
			if child.Name == "CustomMesh" then
				_K.dropPart(child)
			elseif hideOriginals and not PROTECTED_BODY[child.Name] then
				makeInvisible(child)
			end
		end
	end

	-- 2. Interações (portas/vidros) criadas pelo script
	if _DE.S.clear then _DE.S.clear(car) end

	-- 3. Fork criados pelo script
	if forkMeshes[car] then
		for _,e in ipairs(forkMeshes[car]) do
			if e.part and e.part.Parent then makeInvisible(e.part) end
		end
		forkMeshes[car] = {}
	end
	if hideOriginals then
		for _,inst in ipairs(findAllInst(car, "Fork")) do
			for _,child in ipairs(inst.part:GetChildren()) do
				if not PROTECTED_FORK[child.Name] then makeInvisible(child) end
			end
		end
	end

	-- 4. Axel criados pelo script
	if axelMeshes[car] then
		for _,e in ipairs(axelMeshes[car]) do
			if e.part and e.part.Parent then makeInvisible(e.part) end
		end
		axelMeshes[car] = {}
	end
	if hideOriginals then
		for _,inst in ipairs(findAllInst(car, "Axel")) do
			for _,child in ipairs(inst.part:GetChildren()) do
				if not PROTECTED_AXEL[child.Name] then makeInvisible(child) end
			end
		end
	end
end
