-- Encontra todas as instâncias de um BasePart com certo nome dentro das pastas do carro
-- Usado para encontrar TODOS os Fork e TODOS os Axel (pode haver em FR e RR)
local function findAllInst(car,partName)
    local res={}
    for _,folder in ipairs(car:GetChildren()) do
        local p=folder:FindFirstChild(partName)
        if p and p:IsA("BasePart") then table.insert(res,{folder=folder,part=p}) end
    end
    return res
end

