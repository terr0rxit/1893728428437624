function SLX.anc(s,T)
    local chain,p,g={},s.parent,0
    while p and g<8 do table.insert(chain,1,p);p=p.parent;g=g+1 end
    local m=CFrame.new()
    for _,a in ipairs(chain) do m=m*(T[a] or CFrame.new()) end
    return m
end

-- Recalcula o Weld de todos os itens das seções (pose base * transformações das seções)
function SLX.recompute(car,skipArrow)
    local list=SLX.I[car];if not list or #list==0 then return end
    local T={};for _,s in ipairs(list) do T[s]=SLX.T(s) end
    local per={}
    for _,s in ipairs(list) do
        for e in pairs(s.members) do
            per[e]=per[e] or {}
            local x,g=s,0
            while x and g<8 do per[e][x]=true;x=x.parent;g=g+1 end
        end
    end
    for e,set in pairs(per) do
        if SLX.alive(e) and e.weld:IsA("Weld") then
            local arr={};for s in pairs(set) do table.insert(arr,s) end
            table.sort(arr,function(a,b) local da,db=SLX.depth(a),SLX.depth(b);if da~=db then return da<db end;return a.idx<b.idx end)
            local m=CFrame.new()
            for _,s in ipairs(arr) do m=m*T[s] end
            e.weld.C0=m*SLX.base(e)
        end
    end
    for _,s in ipairs(list) do
        if s.weld and s.weld.Parent then s.weld.C0=SLX.anc(s,T)*SLX.P(s) end
        if not skipArrow and s.arrow then pcall(SLX.updArrow,s) end
    end
end

function SLX.mkPivot(car,s)
