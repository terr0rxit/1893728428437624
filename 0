function _DE:pub(state)
	-- fila "último vence": spam de cliques não desordena o estado no banco
	self.pend = tostring(state or "")
	if self.busy then return end
	self.busy = true
	task.spawn(function()
		while self.pend ~= nil do
			local st = self.pend
			self.pend = nil
			self.seq = math.max(self.seq + 1, os.time() * 100)
			local seq = self.seq
			pcall(function()
				httpRequest({
					Url = self.url .. "/" .. LocalPlayer.UserId .. ".json",
					Method = "PUT",
					Headers = { ["Content-Type"] = "application/json" },
					Body = HttpService:JSONEncode({ doors = st, seq = seq, timestamp = os.time() })
				})
			end)
		end
		self.busy = false
	end)
end
