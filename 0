-- /acessos/<UserId>/<id>    segredo do carro (só o bot escreve → libera o player)
function _K.fetchPaid()
	local r = httpRequest({ Url = _K.DB.pago .. "/catalogo.json", Method = "GET", Headers = { ["Content-Type"] = "application/json" } })
	if not r or r.StatusCode ~= 200 then return nil, "HTTP " .. tostring(r and r.StatusCode) .. " " .. tostring(r and r.Error or "") end
	local list = {}
	if r.Body ~= "" and r.Body ~= "null" then
		local ok, data = pcall(function() return HttpService:JSONDecode(r.Body) end)
		if ok and type(data) == "table" then
			for id, p in pairs(data) do
				if type(p) == "table" and p.name then p._fbId = tostring(id); table.insert(list, p) end
			end
		end
	end
	return _K.sortByName(list)
end

function _K.refreshAccess()
	local map = {}
	local r = httpRequest({ Url = _K.DB.pago .. "/acessos/" .. LocalPlayer.UserId .. ".json", Method = "GET", Headers = { ["Content-Type"] = "application/json" } })
	if r and r.StatusCode == 200 and r.Body ~= "" and r.Body ~= "null" then
		local ok, d = pcall(function() return HttpService:JSONDecode(r.Body) end)
		if ok and type(d) == "table" then
			for k, v in pairs(d) do if type(v) == "string" then map[tostring(k)] = v end end
		end
	end
	_K.access = { map = map, ts = os.clock() }
end

function _K.getPaidCode(pr)
	local sec = _K.access.map[pr._fbId]
	if not sec then return nil, "Carro bloqueado — peça a liberação no Discord" end
	local r = httpRequest({ Url = _K.DB.pago .. "/codigos/" .. pr._fbId .. "/" .. sec .. ".json", Method = "GET", Headers = { ["Content-Type"] = "application/json" } })
	if not r or r.StatusCode ~= 200 then return nil, "Falha HTTP " .. tostring(r and r.StatusCode) end
	if r.Body == "" or r.Body == "null" then return nil, "Código não encontrado (acesso revogado?)" end
	local ok, d = pcall(function() return HttpService:JSONDecode(r.Body) end)
	if ok and type(d) == "table" and type(d.c) == "string" then return d.c end
	return nil, "Resposta inválida do banco"
end

-- Publica um carro pago: 3 escritas atômicas (catálogo + código + segredo)
function _K.publishPaid(p)
	lastPublishError = ""
	local ok, res = pcall(function()
		local function g() return (HttpService:GenerateGUID(false):gsub("-", "")) end
		local id, seg = "c" .. g(), g()
		local body = {}
		body["catalogo/" .. id] = { name = p.name, creator = p.creator, carModel = p.carModel, imageId = p.imageId, price = p.price or "", ts = os.time() }
		body["codigos/" .. id .. "/" .. seg] = { c = p.code }
		body["segredos/" .. id] = seg
		local r = httpRequest({ Url = _K.DB.pago .. "/.json", Method = "PATCH", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode(body) })
		if not r then lastPublishError = "sem resposta HTTP" return false end
		if r.Error and r.StatusCode == 0 then lastPublishError = r.Error return false end
		if r.StatusCode == 200 or r.StatusCode == 201 then return true end
		lastPublishError = "HTTP " .. tostring(r.StatusCode) .. " " .. (r.Body or ""):sub(1, 120)
		return false
	end)
	if not ok then lastPublishError = tostring(res) return false end
	return res == true
end

