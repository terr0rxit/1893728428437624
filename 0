-- Seção = itens escolhidos + ponto inicial (pivô) + tipo (porta gira / vidro desliza).
-- A pose base (e.pos / e.rot) NUNCA é alterada: só o Weld é recalculado a cada frame.
-- Abrir/fechar apenas muda o alvo (target); um único driver anima todas juntas.
local SLX=_DE.S
SLX.I={};SLX.n=0;SLX.sel={}

function SLX.list(car) SLX.I[car]=SLX.I[car] or {};return SLX.I[car] end
function SLX.find(car,name) for _,s in ipairs(SLX.I[car] or {}) do if s.name==name then return s end end end
function SLX.alive(e) return e and e.part and e.part.Parent and e.weld and e.weld.Parent and e.type=="body" end
function SLX.count(s) local n=0;for e in pairs(s.members) do if SLX.alive(e) then n=n+1 end end;return n end
function SLX.base(e) local p,r=e.pos,e.rot;return CFrame.new(p[1],p[2],p[3])*CFrame.Angles(math.rad(r[1]),math.rad(r[2]),math.rad(r[3])) end
function SLX.axisVec(ax) return ax=="X" and Vector3.new(1,0,0) or (ax=="Z" and Vector3.new(0,0,1) or Vector3.new(0,1,0)) end
function SLX.P(s) return CFrame.new(s.pos[1],s.pos[2],s.pos[3])*CFrame.Angles(math.rad(s.rot[1]),math.rad(s.rot[2]),math.rad(s.rot[3])) end
function SLX.center(s)
    local cx,cy,cz,n=0,0,0,0
    for e in pairs(s.members) do if SLX.alive(e) then cx=cx+e.pos[1];cy=cy+e.pos[2];cz=cz+e.pos[3];n=n+1 end end
    if n==0 then return Vector3.new(s.pos[1],s.pos[2],s.pos[3]) end
    return Vector3.new(cx/n,cy/n,cz/n)
end
function SLX.carCenter(car)
    local x,y,z,n=0,0,0,0
    for _,e in ipairs(meshesPerCar[car] or {}) do if SLX.alive(e) then x=x+e.pos[1];y=y+e.pos[2];z=z+e.pos[3];n=n+1 end end
    if n==0 then return Vector3.new() end
    return Vector3.new(x/n,y/n,z/n)
end
-- Direção do movimento (espaço do Main). Modo AUTO: depende da POSIÇÃO do bloco base
--  · Vidro: desliza do centro das peças EM DIREÇÃO ao bloco (dist 0 = até o bloco)
--  · Porta: abre PARA FORA do carro, qualquer que seja o lado onde o bloco (dobradiça) está
-- Modo MANUAL: usa o eixo (X/Y/Z) girado pela rotação do bloco, como antes.
function SLX.solve(s)
    local P=SLX.P(s);local v=SLX.axisVec(s.axis)
    local nm=0;for e in pairs(s.members) do if SLX.alive(e) then nm=nm+1 end end
    local key=string.format("%.3f|%.3f|%.3f|%.2f|%.2f|%.2f|%s|%s|%d|%d",s.pos[1],s.pos[2],s.pos[3],s.rot[1],s.rot[2],s.rot[3],tostring(s.axis),tostring(s.auto),nm,#(meshesPerCar[s.car] or {}))
    if s._k==key and s._r then return s._r end
    local C=SLX.center(s);local res={}
    if s.kind=="glass" then
        local d
        if s.auto then
            local dv=P.Position-C
            if dv.Magnitude>0.05 then d=dv.Unit;res.reach=dv.Magnitude end
        end
        res.dir=d or P:VectorToWorldSpace(v)
    else
        local ax=P:VectorToWorldSpace(v)
        local t=ax:Cross(C-P.Position)
        local sg=1
        if s.auto and t.Magnitude>1e-4 then
            local cc=SLX.carCenter(s.car)
            local out=Vector3.new(C.X-cc.X,0,C.Z-cc.Z)
            if out.Magnitude>0.05 then sg=(t:Dot(out)>=0) and 1 or -1 end
        end
        res.dir=(t.Magnitude>1e-4) and (t.Unit*sg) or ax
        res.sg=sg
    end
    s._k=key;s._r=res
    return res
end
function SLX.T(s)
    local c=s.cur or 0
    if c<=0 then return CFrame.new() end
    local P=SLX.P(s);local v=SLX.axisVec(s.axis)
    local val=s.value or ((s.kind=="glass") and 1 or 70)
    local r=SLX.solve(s)
    if s.kind=="glass" then
        local dist=val
        if s.auto and val==0 and r.reach then dist=r.reach end
        return CFrame.new(r.dir*(dist*c))
    end
    return P*CFrame.fromAxisAngle(v,math.rad(val*(r.sg or 1)*c))*P:Inverse()
end
-- Seta no bloco base mostrando para onde a seção vai (acompanha posição/rotação do bloco)
function SLX.setVis(s,tr)
    if s.part and s.part.Parent then s.part.Transparency=tr end
    local a=s.arrow
    if a then
        if a.sh and a.sh.Parent then a.sh.Transparency=tr end
        if a.tip and a.tip.Parent then a.tip.Transparency=tr end
    end
end
function SLX.mkArrow(s)
    if not s.part then return end
    local function mk(sz)
        local q=Instance.new("Part");q.Size=sz;q.Material=Enum.Material.Neon;q.Color=s.part.Color
