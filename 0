function SLX.updArrow(s)
    local a=s.arrow;if not a or not a.sh.Parent then return end
    local P=SLX.P(s);local r=SLX.solve(s)
    local dA=r.dir;if (s.value or 1)<0 then dA=-dA end
    local dl=P:VectorToObjectSpace(dA)
    if dl.Magnitude<1e-4 then dl=Vector3.new(0,1,0) end
    dl=dl.Unit
    local key=string.format("%.3f|%.3f|%.3f",dl.X,dl.Y,dl.Z)
    if s._ak==key then return end
    s._ak=key
    local up=(math.abs(dl.Y)>0.95) and Vector3.new(1,0,0) or Vector3.new(0,1,0)
    a.sw.C0=CFrame.lookAt(dl*0.75,dl*1.75,up)
