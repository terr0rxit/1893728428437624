function SLX.add(car,name,kind,members,parent,opts)
    if not car then return false,"Carro inválido" end
    kind=(kind=="glass") and "glass" or "door"
    name=tostring(name or "");name=name:gsub("[;|>,]","");name=name:match("^%s*(.-)%s*$")
    if name=="" then name=(kind=="glass") and "Vidro" or "Porta" end
    local base,k=name,1
    while SLX.find(car,name) do k=k+1;name=base.." "..k end
    if not getMain(car) then return false,"'Main' não encontrado!" end
    SLX.n=SLX.n+1
    local cx,cy,cz,cn=0,0,0,0
    for _,e in ipairs(members or {}) do if SLX.alive(e) then cx=cx+e.pos[1];cy=cy+e.pos[2];cz=cz+e.pos[3];cn=cn+1 end end
    local s={car=car,name=name,kind=kind,members={},pos=(cn>0) and {cx/cn,cy/cn,cz/cn} or {0,0,0},rot={0,0,0},axis="Y",auto=true,value=(kind=="glass") and 1 or 70,visible=true,cur=0,target=0,idx=SLX.n,parent=parent}
    if opts then for key,v in pairs(opts) do s[key]=v end end
    for _,e in ipairs(members or {}) do if SLX.alive(e) then s.members[e]=true end end
    SLX.mkPivot(car,s)
