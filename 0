-- ══ OFUSCAÇÃO B64+XOR (chunked — sem limite de tamanho) ═══════
local B64="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64R={};for i=1,#B64 do B64R[B64:sub(i,i)]=i-1 end
local XOR_KEY={87,104,101,101,108,115,67,117,115,116,111,109,105,122,101,114}
_K.KEY_LEN=#XOR_KEY
-- Processa em blocos de 3 bytes → 4 chars B64 (nunca carrega o byte array inteiro)
function _K.b64E(s)
	local len=#s
	if len==0 then return "" end
	local o={}
	local oi=1
	for i=1,len,3 do
		local b1=string.byte(s,i) or 0
		local b2=string.byte(s,i+1)
		local b3=string.byte(s,i+2)
		local n=b1*65536+(b2 or 0)*256+(b3 or 0)
		o[oi]=B64:sub(math.floor(n/262144)+1,math.floor(n/262144)+1); oi=oi+1
		o[oi]=B64:sub(math.floor(n/4096)%64+1,math.floor(n/4096)%64+1); oi=oi+1
		o[oi]=b2 and B64:sub(math.floor(n/64)%64+1,math.floor(n/64)%64+1) or "="; oi=oi+1
		o[oi]=b3 and B64:sub(n%64+1,n%64+1) or "="; oi=oi+1
	end
	return table.concat(o)
end
-- Decodifica B64 em chunks de 4 chars
function _K.b64D(s)
	local clean=s:gsub("[^A-Za-z0-9+/]","") -- remove padding e lixo
	local len=#clean
	if len==0 then return "" end
	local o={}
	local oi=1
	for i=1,len,4 do
		local b1=B64R[clean:sub(i,i)] or 0
		local b2=B64R[clean:sub(i+1,i+1)] or 0
		local b3=B64R[clean:sub(i+2,i+2)]
		local b4=B64R[clean:sub(i+3,i+3)]
		local n=b1*262144+b2*4096+(b3 or 0)*64+(b4 or 0)
		o[oi]=string.char(math.floor(n/65536)); oi=oi+1
		if b3 then o[oi]=string.char(math.floor(n/256)%256); oi=oi+1 end
		if b4 then o[oi]=string.char(n%256); oi=oi+1 end
	end
	return table.concat(o)
end
-- XOR em chunks de 4096 bytes (evita tabela gigante)
local function xorC(s)
	local len=#s
	if len==0 then return "" end
	local CHUNK=4096
	local o={}
	local oi=1
	for start=1,len,CHUNK do
		local stop=math.min(start+CHUNK-1,len)
		local t={}
		local ti=1
		for i=start,stop do
			local v=string.byte(s,i)
			t[ti]=string.char(bit32.bxor(v,XOR_KEY[((i-1)%_K.KEY_LEN)+1]))
			ti=ti+1
		end
		o[oi]=table.concat(t)
		oi=oi+1
	end
	return table.concat(o)
end
function _K.obfuscate(s)
	if type(s)~="string" or s=="" then return "" end
	return _K.b64E(xorC(s))
end
function _K.deobfuscate(s)
	if type(s)~="string" or s=="" then return "" end
	return xorC(_K.b64D(s))
end
function _K.isObf(c)
	return type(c)=="string" and not c:find(";") and c:match("^[A-Za-z0-9+/]+=*$")~=nil
end

